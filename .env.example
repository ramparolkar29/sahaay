# Copy to .env.local for local overrides. All values are optional in development.

# 32+ character random string. Required in production (Vercel, Cloud Run);
# dev falls back to data/.session-secret.
SESSION_SECRET=

# Bearer secret for /api/cron/reminders. Required in production.
# Vercel cron sends it automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Writable location for the SQLite file.
# Local default: data/sahaay.db. On Vercel the default is /tmp/sahaay.db
# (ephemeral, per instance — fine for the seeded demo only).
SAHAY_DB_PATH=

# Set on Cloud Run so queued email is handed to the Firestore `mail` collection
# (Trigger Email extension). Leave empty to keep messages in the local outbox.
FIRESTORE_PROJECT=
